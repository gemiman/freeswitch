<include>
  <!-- 
      阿里云国际语音 SIP Trunk 配置 
      文档参考: https://www.alibabacloud.com/help/zh/voice-service
  -->
  <gateway name="aliyun-intl">
    <!-- 阿里云提供的 SIP 接入点域名或 IP -->
    <param name="proxy" value="sip-hk.aliyun.com"/>
    <param name="realm" value="sip-hk.aliyun.com"/>
    
    <!-- 认证模式: IP 白名单模式下，username/password 可随意或留空 -->
    <param name="username" value="your-account-id"/>
    <param name="password" value="your-password"/>
    
    <!-- 注册模式: 阿里云通常是 Peering 模式，不需要 REGISTER -->
    <param name="register" value="false"/>
    
    <!-- 心跳检测 -->
    <param name="ping" value="25"/>
    <param name="retry-seconds" value="30"/>
    
    <!-- 呼叫参数 -->
    <param name="context" value="public"/>
    <param name="caller-id-in-from" value="true"/>
    <param name="extension-in-contact" value="true"/>
  </gateway>
</include>
