<profile name="internal">
  <settings>
    <!-- 基础网络 -->
    <param name="sip-ip" value="$${local_ip_v4}"/>
    <param name="rtp-ip" value="$${local_ip_v4}"/>
    <param name="ext-rtp-ip" value="$${external_rtp_ip}"/>
    <param name="ext-sip-ip" value="$${external_sip_ip}"/>
    
    <!-- 端口绑定 -->
    <param name="sip-port" value="$${internal_sip_port}"/>
    <param name="tls-sip-port" value="$${internal_tls_port}"/>
    <param name="ws-binding" value=":5066"/>
    <param name="wss-binding" value=":7443"/>
    
    <!-- TLS 设置 -->
    <param name="tls" value="true"/>
    <param name="tls-only" value="false"/>
    <param name="tls-bind-params" value="transport=tls"/>
    <param name="tls-cert-dir" value="$${conf_dir}/ssl"/>
    
    <!-- WebRTC & TURN 关键配置 -->
    <param name="stun-server" value="$${turn_server_ip}:3478"/>
    <param name="turn-server" value="$${turn_server_ip}:3478:udp"/>
    <param name="credential-mechanisms" value="turn-rest-auth"/>
    <param name="turn-rest-auth-user" value="timestamp"/>
    <param name="turn-rest-auth-server" value=""/> 
    <param name="turn-rest-auth-shared-secret" value="$${turn_server_passwd}"/>
    <param name="turn-rest-auth-token-ttl" value="86400"/>
    
    <!-- 媒体处理 -->
    <param name="inbound-bypass-media" value="false"/>
    <param name="media-option" value="resume-media-on-hold"/>
    <param name="rtp-timer-name" value="soft"/>
    
    <!-- 安全控制 -->
    <param name="auth-calls" value="true"/>
    <param name="apply-nat-acl" value="nat.auto"/>
    <param name="apply-inbound-acl" value="domains"/>
    <param name="local-network-acl" value="localnet.auto"/>
    
    <!-- 调试 -->
    <param name="debug" value="0"/>
    <param name="sip-trace" value="no"/>
    <param name="log-auth-failures" value="true"/>
    <param name="forward-unsolicited-mwi-notify" value="false"/>
    <param name="context" value="public"/>
    <param name="rfc2833-pt" value="101"/>
    <param name="dtmf-duration" value="2000"/>
    <param name="hold-music" value="$${hold_music}"/>
    <param name="record-path" value="$${recordings_dir}"/>
    <param name="record-template" value="${caller_id_number}.${target_domain}.${strftime(%Y-%m-%d-%H-%M-%S)}.wav"/>
    <param name="manage-presence" value="true"/>
    <param name="presence-hosts" value="$${domain},$${local_ip_v4}"/>
    <param name="manage-shared-appearance" value="true"/>
    <param name="dbname" value="share_presence"/>
    <param name="presence-proto" value="sip"/>
    <param name="liberal-dtmf" value="true"/>
    <param name="watch-registrations" value="true"/> 
  </settings>
</profile>
