# Coturn TURN Server 配置文件示例
# 对应 docker-compose.yml 中的挂载路径: /etc/coturn/turnserver.conf

# 监听端口
listening-port=3478
tls-listening-port=5349

# 外部 IP (必须配置为你的公网 IP)
# external-ip=1.2.3.4

# 域名 (Realm)
realm=rtc.example.com

# 端口范围 (必须与 FreeSWITCH RTP 范围错开)
min-port=49152
max-port=65535

# 安全与认证
use-auth-secret
static-auth-secret=MySuperSecretKey123
no-auth-ping

# TLS 证书 (如果需要 TURN over TLS)
# cert=/etc/coturn/turn_server_cert.pem
# pkey=/etc/coturn/turn_server_pkey.pem

# 日志
log-file=stdout
simple-log

# CLI 密码 (防止 Coturn 报错)
cli-password=123456
